<p data-start="526" data-end="622"><span class="" data-state="closed"><button class="behavior-btn hover:entity-accent focus-visible:focus-ring entity-underline inline cursor-pointer appearance-none border-0 bg-transparent p-0 text-start align-baseline text-inherit" type="button">חבילת דף הנחיתה המוכנה</button></span></p>
</li>
<li data-section-id="imgwih" data-start="623" data-end="728">
<p data-start="625" data-end="728"><span class="" data-state="closed"><button class="behavior-btn hover:entity-accent focus-visible:focus-ring entity-underline inline cursor-pointer appearance-none border-0 bg-transparent p-0 text-start align-baseline text-inherit" type="button">פרויקט הסרט הניתן לעריכה</button></span></p>
</li>
